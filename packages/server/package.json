{
  "name": "@session-share/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --disable-warning=ExperimentalWarning dist/index.js",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@session-share/protocol": "workspace:*",
    "fastify": "^5.2.0",
    "ws": "^8.18.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
