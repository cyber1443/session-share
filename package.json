{
  "name": "session-share",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "demo": "turbo run build && node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "peer-demo": "pnpm bundle && node --disable-warning=ExperimentalWarning scripts/peer-demo.mjs",
    "bundle": "turbo run build && pnpm --filter @session-share/web export && node scripts/bundle-plugin.mjs",
    "server": "turbo run build && pnpm --filter @session-share/server start",
    "attach": "node scripts/attach.mjs",
    "lint": "turbo run lint",
    "check-bundle": "node scripts/check-bundle.mjs",
    "git-flow-demo": "pnpm bundle && node --disable-warning=ExperimentalWarning scripts/git-flow-demo.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
